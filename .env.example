# .env.example — copy this to .env and fill in your real values
# Never commit .env to Git

# Flask
SECRET_KEY=change-me-to-a-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=1

# MySQL connection (matches Person 1 foundation)
# Format: mysql+pymysql://user:password@host:port/dbname
DB_USER=root
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=3306
DB_NAME=subscription_db

DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/subscription_db

# Invoice / subscription settings (optional overrides)
DEFAULT_PAYMENT_TERMS_DAYS=30
DEFAULT_TAX_RATE=0.18

